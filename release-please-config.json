{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "separate-pull-requests": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "quilldown",
      "component": "",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        "Cargo.toml",
        "runtimes/rust/quilldown-cli/Cargo.toml"
      ]
    },
    "runtimes/python": {
      "release-type": "python",
      "component": "quilldown-python",
      "package-name": "quilldown",
      "changelog-path": "CHANGELOG.md"
    }
  }
}
